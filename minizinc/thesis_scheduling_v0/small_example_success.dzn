% Example data for thesis defense scheduling problem

% Basic parameters
J = 2;  % 2 juries
S = 3;  % 3 slots per jury
C = 2;  % Capacity of 2 defenses per slot
N = 6;  % 6 students
K = 3;  % 3 companies
A = 2;  % 2 advisors

% Student assignments:
% student_jury: which jury each student belongs to
student_jury = [1, 1, 1, 2, 2, 2];

% student_company: which company each student is from
student_company = [1, 2, 3, 1, 2, 3];

% student_advisor: which advisor each student has
student_advisor = [1, 2, 1, 2, 1, 2];

% Company incompatibility - arrays of incompatible company pairs
% Each pair (c1, c2) means company c1 and c2 cannot be in same slot
num_incompatible_pairs = 2;
incompatible_pairs_c1 = [1, 2];
incompatible_pairs_c2 = [2, 3];