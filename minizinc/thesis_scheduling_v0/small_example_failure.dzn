% Example that fails due to company incompatibility constraints

% Basic parameters
J = 1;   % 1 jury
S = 2;   % 2 slots per jury
C = 3;   % Capacity of 3 defenses per slot
N = 4;   % 4 students
K = 3;   % 3 companies
A = 2;   % 2 advisors

% Student assignments:
% All students in the same jury
student_jury = [1, 1, 1, 1];

% Students from 3 different companies
student_company = [1, 2, 3, 1];

% Advisor assignments
student_advisor = [1, 2, 1, 2];

% Complex company incompatibilities that make scheduling impossible
% Company 1 incompatible with both 2 and 3
% Company 2 incompatible with both 1 and 3
% This creates a situation where no two companies can be together
num_incompatible_pairs = 3;
incompatible_pairs_c1 = [1, 1, 2];
incompatible_pairs_c2 = [2, 3, 3];